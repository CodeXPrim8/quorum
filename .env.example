VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix this with VITE_ — it must not reach the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# Server only. Voice (GPT Live / WebRTC) and Maya’s photograph layer (DALL·E). Never VITE_. DeepSeek stays the chat brain.
OPENAI_API_KEY=
# Server only. Quorum’s chat brain when set. Never VITE_. The key must not reach the browser.
XAI_API_KEY=
XAI_MODEL=grok-4
# Server only. Platform Meta app for multi-company connect. Never VITE_.
# Each company connects its own Instagram (OAuth) and WhatsApp (token form) under Integrations.
META_APP_ID=
META_APP_SECRET=
# 64 hex chars or any passphrase (hashed to AES-256). Encrypts per-company tokens in data/meta-connections.json.
META_ENCRYPT_KEY=
# Public https origin of this Quorum server (ngrok / Cloudflare Tunnel / host). Used for OAuth callback and Instagram image fetch.
META_PUBLIC_BASE=
# Optional single-tenant fallbacks (CLEMX / one company on this machine). Prefer Integrations connect when META_* is set.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
INSTAGRAM_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_PUBLIC_BASE=
